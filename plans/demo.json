    { "type": "tv",          "pos": [0.32, 6.0],  "rot": 90,  "width": 1.7, "entity": "media_player.demo_tv" },
    { "type": "sofa",        "pos": [3.95, 6.0],  "rot": -90, "width": 2.5, "color": "#8b93a7" },
    { "type": "coffeeTable", "pos": [2.3, 6.0],   "rot": 90 },
    { "type": "armchair",    "pos": [1.9, 4.35],  "rot": 12,  "color": "#c28a5a" },
    { "type": "plant",       "pos": [0.5, 7.65],  "height": 1.5 },
    { "type": "sideboard",   "pos": [5.2, 7.85],  "rot": 180, "width": 1.6 },

    { "type": "diningSet",   "pos": [8.5, 6.4],   "width": 1.9, "chairs": 6 },
    { "type": "island",      "pos": [8.5, 3.75],  "width": 2.2, "stools": 3 },
    { "type": "kitchen",     "pos": [8.05, 0.41], "width": 3.1, "upper": true },
    { "type": "fridge",      "pos": [10.02, 0.45] },

    { "type": "rug",         "pos": [2.1, 2.3],   "size": [2.6, 1.6], "color": "#6a5a52" },
    { "type": "bed",         "pos": [2.1, 1.2],   "width": 1.7, "color": "#7f8fb5" },
    { "type": "nightstand",  "pos": [0.85, 0.4] },
