    { "type": "poolTable",    "pos": [2.9, 10.7] },
    { "type": "sectional",    "pos": [6.2, 12.25], "rot": 180, "width": 2.6 },
    { "type": "treadmill",    "pos": [7.4, 9.4] },
    { "type": "glassCabinet", "pos": [0.9, 13.0],  "rot": 180 },
    { "type": "bookshelf",    "pos": [10.2, 9.3],  "rot": -90 },
    { "type": "walkInCloset", "pos": [8.3, 9.2],   "rot": 90 },
    { "type": "daybed",       "pos": [1.5, 14.25], "rot": 180, "trundle": true },

    { "type": "wetBar",       "pos": [2.6, 0.33],  "width": 2.4, "storey": "basement" },
