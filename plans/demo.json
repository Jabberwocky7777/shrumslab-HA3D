{
  "version": 1,
  "name": "Demo House",
  "wallHeight": 2.6,
  "interiorWallHeight": 1.25,
  "camera": { "azimuth": 30, "elevation": 48 },
  "outdoorTemp": 24,

  "floors": [
    { "id": "main", "name": "Main", "level": 0,
      "actions": [
        { "id": "on", "name": "Lights on", "icon": "sun", "run": "script.demo_main_lights_on" },
        { "id": "off", "name": "All off", "icon": "moon", "builtin": "all_off" },
        { "id": "movie", "name": "Movie", "icon": "film", "run": "scene.demo_movie",
          "active_when": [{ "entity": "media_player.demo_tv", "state": "playing" },
                          { "entity": "input_boolean.demo_movie_mode", "state": "on" }] }
      ] },
    { "id": "basement", "name": "Basement", "level": -1, "height": 2.4,
      "actions": [
        { "id": "on", "name": "All on", "icon": "sun", "builtin": "all_on" },
        { "id": "off", "name": "All off", "icon": "moon", "builtin": "all_off" },
        { "id": "game", "name": "Game night", "icon": "film", "run": "script.demo_movie_mode",
          "confirmation": { "text": "Dim the bar and start game night?" } },
        { "id": "guests", "name": "Guests", "icon": "bed", "toggle": "input_boolean.demo_guest_mode", "confirmation": true }
      ] }
  ],

  "rooms": [
    { "id": "bedroom", "name": "Bedroom",  "rect": [0, 0, 4.2, 3.6],     "floor": "walnut", "storey": "main",
      "temperature": "sensor.demo_bedroom_temperature" },
    { "id": "bath",    "name": "Bathroom", "rect": [4.2, 0, 2.2, 3.6],   "floor": "tile", "storey": "main" },
    { "id": "kitchen", "name": "Kitchen",  "rect": [6.4, 0, 4.0, 3.6],   "floor": "stone", "storey": "main", "area": ["demo_kitchen", "Pantry"],
      "occupancy": ["binary_sensor.demo_kitchen_motion"], "temperature": "sensor.demo_kitchen_temperature" },
    { "id": "office",  "name": "Office",   "rect": [10.4, 0, 3.2, 3.6],  "floor": "oak", "storey": "main" },
    { "id": "living",  "name": "Living",   "rect": [0, 3.6, 6.4, 4.6],   "floor": "oak", "storey": "main", "area": "demo_living",
      "occupancy": ["binary_sensor.demo_living_motion"], "temperature": "sensor.demo_living_temperature" },
    { "id": "dining",  "name": "Dining",   "rect": [6.4, 3.6, 4.0, 4.6], "floor": "oak", "storey": "main" },
    { "id": "hall",    "name": "Hall",     "rect": [10.4, 3.6, 3.2, 4.6], "floor": "stone", "storey": "main" },
    { "id": "rec",     "name": "Rec room", "rect": [0, 8.2, 8.0, 5.0],    "floor": "carpet", "storey": "main",
      "occupancy": "binary_sensor.demo_rec_motion" },
    { "id": "rec_nook", "name": "Rec nook", "rect": [0, 13.2, 3.0, 1.6],  "floor": "carpet", "storey": "main", "part_of": "rec" },
    { "id": "storage", "name": "Storage",  "rect": [8.0, 8.2, 2.4, 2.0],  "floor": "stone", "storey": "main" },

    { "id": "bar",     "name": "Bar",      "rect": [0, 0, 6.4, 4.4],     "floor": "walnut", "storey": "basement" },
    { "id": "gym",     "name": "Gym",      "rect": [6.4, 0, 4.0, 4.4],   "floor": "stone",  "storey": "basement" },
    { "id": "utility", "name": "Utility",  "rect": [10.4, 0, 3.2, 4.4],  "floor": "tile",   "storey": "basement" }
  ],

  "openings": [
    { "type": "door",   "from": [3.1, 3.6],   "to": [4.0, 3.6] },
    { "type": "door",   "from": [4.7, 3.6],   "to": [5.5, 3.6] },
    { "type": "open",   "from": [6.4, 4.2],   "to": [6.4, 7.8] },
    { "type": "open",   "from": [7.0, 3.6],   "to": [10.0, 3.6] },
    { "type": "door",   "from": [10.4, 5.4],  "to": [10.4, 6.4] },
    { "type": "door",   "from": [11.2, 3.6],  "to": [12.1, 3.6] },
    { "type": "door",   "from": [11.6, 8.2],  "to": [12.6, 8.2],
      "contact": "binary_sensor.demo_front_door", "lock": "lock.demo_front_door" },
    { "type": "window", "from": [0, 1.0],     "to": [0, 2.6] },
    { "type": "window", "from": [0, 7.0],     "to": [0, 7.9], "contact": "binary_sensor.demo_living_window" },
    { "type": "window", "from": [0.9, 0],     "to": [2.3, 0], "sill": 1.5, "head": 2.2 },
    { "type": "window", "from": [11.0, 0],    "to": [13.0, 0] },
    { "type": "door",   "from": [1.4, 8.2],   "to": [2.3, 8.2] },
    { "type": "window", "from": [0, 9.8],     "to": [0, 11.4] },
    { "type": "door",   "from": [8.7, 8.2],   "to": [9.5, 8.2] },
    { "type": "garage", "from": [8.2, 10.2],  "to": [10.2, 10.2], "head": 2.0, "cover": "cover.demo_garage_door" },

    { "type": "door",   "from": [6.4, 3.2],   "to": [6.4, 4.1], "storey": "basement" },
    { "type": "door",   "from": [10.4, 1.0],  "to": [10.4, 1.9], "storey": "basement" },
    { "type": "window", "from": [0, 1.2],     "to": [0, 2.6], "sill": 1.6, "head": 2.1, "storey": "basement" }
  ],

  "furniture": [
