      "link": { "service": "homeassistant", "id": "light.demo_rec_sconces" } },
    { "id": "rec.fan",        "name": "Fan light",     "room": "rec",     "type": "fan",     "pos": [5.2, 9.6], "spin": "fan.demo_rec_fan",
      "link": { "service": "homeassistant", "id": "light.demo_rec_fan_light" } },
    { "id": "rec.dome",       "name": "Entry",         "room": "rec",     "type": "dome",    "pos": [1.85, 8.9],
      "link": { "service": "homeassistant", "id": "light.demo_rec_dome" } },
    { "id": "rec.nook",       "name": "Nook light",    "room": "rec_nook", "type": "dome",   "pos": [1.5, 13.9], "placeholder": true },

    { "id": "bar.pendants",   "name": "Poker table",   "room": "bar",     "type": "pendantBar", "pos": [2.2, 2.7], "y": 1.5,
      "length": 1.2, "link": { "service": "homeassistant", "id": "light.demo_bar_pendants" } },
    { "id": "bar.cans",       "name": "Cans",          "room": "bar",     "type": "cans",    "pos": [2.6, 1.6],
      "points": [[1.2, 1.4], [4.0, 1.4], [1.2, 3.6], [4.0, 3.6]],
      "link": { "service": "homeassistant", "id": "light.demo_bar_cans" } },
    { "id": "gym.main",       "name": "Ceiling",       "room": "gym",     "type": "ceiling", "pos": [8.4, 2.2],
      "link": { "service": "homeassistant", "id": "light.demo_gym_ceiling" } },
    { "id": "utility.main",   "name": "Light",         "room": "utility", "type": "dome",    "pos": [12.0, 2.2],
      "link": { "service": "homeassistant", "id": "light.demo_utility_light" } }
  ],

  "acs": [
    { "id": "bedroom.ac", "name": "Bedroom AC", "room": "bedroom", "wall": "north", "pos": [3.3, 0], "y": 2.2,
      "link": { "service": "homeassistant", "id": "climate.demo_bedroom_ac" } }
  ],

  "entities": [
    { "id": "living.tv_player", "name": "TV",          "room": "living",  "entity": "media_player.demo_tv",
      "pos": [0.5, 5.0], "y": 1.6, "icon": "tv",
      "tap_action": { "action": "more-info" },
      "hold_action": { "action": "perform-action", "perform_action": "media_player.media_play_pause",
                       "target": { "entity_id": "media_player.demo_tv" }, "confirmation": { "text": "Play or pause the TV?" } },
      "double_tap_action": { "action": "toggle" } },
    { "id": "bedroom.fan",      "name": "Ceiling fan", "room": "bedroom", "entity": "fan.demo_bedroom_fan",
      "pos": [2.1, 1.2], "y": 2.2, "icon": "fan", "tap": "toggle" },
    { "id": "kitchen.coffee",   "name": "Coffee maker", "room": "kitchen", "entity": "switch.demo_coffee_maker",
      "pos": [6.9, 0.45], "y": 1.2, "icon": "coffee", "tap": "toggle" },
    { "id": "hall.thermostat",  "name": "Thermostat",  "room": "hall",    "entity": "climate.demo_thermostat",
      "pos": [10.55, 4.4], "y": 1.5, "icon": "thermometer", "show": "temperature" },
    { "id": "hall.front_door",  "name": "Front door",  "room": "hall",    "entity": "lock.demo_front_door",
      "pos": [12.1, 7.9], "y": 1.1, "icon": "lock" },
    { "id": "hall.garage",      "name": "Garage door", "room": "hall",    "entity": "cover.demo_garage_door",
      "pos": [13.3, 7.4], "y": 1.3, "icon": "garage" },
    { "id": "hall.porch_cam",   "name": "Porch camera", "room": "hall",   "entity": "camera.demo_porch",
      "pos": [12.9, 8.0], "y": 2.2, "icon": "camera" }
  ],

  "people": [
    { "name": "Demo Person", "entity": "sensor.demo_person_area", "color": "#7ac8ff" },
    { "name": "Demo Guest", "entity": "sensor.demo_guest_area", "color": "#ffb46b" }
  ],

  "scenes": [
    { "id": "bright", "name": "Bright", "icon": "sun",
      "lights": { "*": { "on": true, "brightness": 1, "temp": 4200 } } },
    { "id": "cozy", "name": "Cozy", "icon": "sofa",
      "lights": {
        "*": { "on": false },
        "living.floor":   { "on": true },
        "living.tv":      { "on": true, "brightness": 0.7, "color": "#ff7a3c" },
        "dining.pendant": { "on": true, "brightness": 0.45, "temp": 2400 },
        "kitchen.strip":  { "on": true, "brightness": 0.6, "temp": 2700 },
        "bedroom.left":   { "on": true },
        "bedroom.right":  { "on": true },
        "hall.main":      { "on": true, "brightness": 0.3, "temp": 2400 }
      } },
    { "id": "movie", "name": "Movie", "icon": "film", "run": "script.demo_movie_mode" },
    { "id": "night", "name": "Night", "icon": "moon", "run": "scene.demo_good_night",
      "active_when": { "entity": "input_boolean.demo_night_mode", "state": "on" } },
    { "id": "away", "name": "Away", "icon": "door",
      "lights": { "*": { "on": false } },
      "acs": { "*": { "on": false } } }
  ]
}
