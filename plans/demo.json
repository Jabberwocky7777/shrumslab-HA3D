    { "type": "showerStall",  "pos": [13.05, 3.85], "rot": 180, "door": "side", "storey": "basement" }
  ],

  "lights": [
    { "id": "living.main",    "name": "Ceiling",       "room": "living",  "type": "ceiling", "pos": [2.9, 6.0],
      "link": { "service": "homeassistant", "id": "light.demo_living_ceiling" } },
    { "id": "living.floor",   "name": "Floor lamp",    "room": "living",  "type": "floor",   "pos": [0.6, 4.2],
      "link": { "service": "homeassistant", "id": "switch.demo_floor_lamp" } },
    { "id": "living.tv",      "name": "TV backlight",  "room": "living",  "type": "strip",   "pos": [0.13, 6.0], "y": 1.05,
      "rot": 90, "length": 1.5, "color": "#7b5cff",
      "link": { "service": "homeassistant", "id": "light.demo_tv_backlight" } },

    { "id": "dining.pendant", "name": "Pendant",       "room": "dining",  "type": "pendant", "pos": [8.5, 6.4], "y": 1.75,
      "hold_action": { "action": "more-info" },
      "link": { "service": "homeassistant", "id": "light.demo_dining_pendant" } },

    { "id": "kitchen.spots",  "name": "Spots",         "room": "kitchen", "type": "spots",   "pos": [8.4, 2.0],
      "capabilities": ["brightness"], "power": "sensor.demo_kitchen_spots_power",
      "link": { "service": "homeassistant", "id": "light.demo_kitchen_spots" } },
    { "id": "kitchen.strip",  "name": "Counter light", "room": "kitchen", "type": "strip",   "pos": [8.05, 0.42], "y": 1.42,
      "length": 2.9, "link": { "service": "homeassistant", "id": "light.demo_kitchen_counter" } },

    { "id": "bedroom.main",   "name": "Ceiling",       "room": "bedroom", "type": "ceiling", "pos": [2.1, 2.3],
      "link": { "service": "homeassistant", "id": "light.demo_bedroom_ceiling" } },
    { "id": "bedroom.left",   "name": "Bedside left",  "room": "bedroom", "type": "table",   "pos": [0.85, 0.4], "y": 0.5,
      "link": { "service": "homeassistant", "id": "light.demo_bedside_left" } },
    { "id": "bedroom.right",  "name": "Bedside right", "room": "bedroom", "type": "table",   "pos": [3.35, 0.4], "y": 0.5,
      "link": { "service": "homeassistant", "id": "light.demo_bedside_right" } },

    { "id": "bath.main",      "name": "Ceiling",       "room": "bath",    "type": "ceiling", "pos": [5.2, 2.0],
      "link": { "service": "homeassistant", "id": "light.demo_bath_ceiling" } },
    { "id": "bath.mirror",    "name": "Mirror light",  "room": "bath",    "type": "strip",   "pos": [4.95, 0.14], "y": 1.95,
      "length": 0.8, "link": { "service": "homeassistant", "id": "light.demo_bath_mirror" } },

    { "id": "office.main",    "name": "Ceiling",       "room": "office",  "type": "ceiling", "pos": [12.0, 1.9],
      "link": { "service": "homeassistant", "id": "light.demo_office_ceiling" } },
    { "id": "office.desk",    "name": "Desk lamp",     "room": "office",  "type": "table",   "pos": [12.5, 0.4], "y": 0.75,
      "link": { "service": "homeassistant", "id": "switch.demo_desk_lamp" } },
    { "id": "office.fan",     "name": "Office fan",    "room": "office",  "type": "fan",     "pos": [11.1, 2.7],
      "bowl": false, "spin": "light", "link": { "service": "homeassistant", "id": "switch.demo_office_fan" } },

    { "id": "hall.main",      "name": "Ceiling",       "room": "hall",    "type": "ceiling", "pos": [12.0, 5.9],
      "link": { "service": "homeassistant", "id": "light.demo_hall_ceiling" } },

    { "id": "rec.cans",       "name": "Cans",          "room": "rec",     "type": "cans",    "pos": [6.2, 11.6],
