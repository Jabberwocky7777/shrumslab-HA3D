      "link": { "service": "homeassistant", "id": "light.demo_rec_cans" } },
    { "id": "rec.pool",       "name": "Pool table",    "room": "rec",     "type": "pendantBar", "pos": [2.9, 10.7], "length": 1.4,
      "link": { "service": "homeassistant", "id": "light.demo_rec_pool_table" } },
    { "id": "rec.sconces",    "name": "Sconces",       "room": "rec",     "type": "sconce",  "pos": [0.03, 10.6],
