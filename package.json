{
  "name": "shrumslab-ha3d",
  "version": "0.1.0",
  "description": "A 3D home dashboard card for Home Assistant, based on house-control",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "serve": "node tests/harness/server.mjs",
    "lint": "eslint .",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:render": "playwright test",
    "privacy": "node scripts/privacy-check.mjs",
    "check": "npm run lint && npm run privacy && npm test && npm run build && npm run test:render",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "lucide": "0.544.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.56.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "vite": "8.3.4"
  }
}
